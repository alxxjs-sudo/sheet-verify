# Installed, not authored
node_modules/

# Build output: `npm run build` regenerates all of it from src/
dist/
*.tsbuildinfo

# Test and example output, all written by a command that can be re-run
tests/.fixtures/
test-results/
playwright-report/
examples/out/
examples/cases/
examples/cli-cases/

# Report data. Confidential: golden outputs, downloaded reports, and the
# results of comparing them. Never commit these, and stage explicit paths
# rather than `git add -A` so a future rule change cannot let them through.
#
# Both spellings are listed on purpose. A folder named with a hyphen once sat
# beside the underscored one for an afternoon, uncovered by this file, with 130
# report files visible to git the whole time.
output_comparison/
output-comparison/

# The same trees after they were split by source and flattened: one root per
# system, no wrapper folder repeating its own name. Listed here before the
# folders were created, not after -- see the note above about the hyphenated
# folder that sat uncovered for an afternoon.
edison_output_comparison/
edison-output-comparison/
catwb_output_comparison/
catwb-output-comparison/

# The same rule, for the trees that hold the reports themselves. These are not
# on every machine, which is exactly why they are listed before one appears:
# a folder becomes visible to git the moment it lands, not the moment somebody
# remembers it.
report-comparison/
report_comparison/
actual_reports/
actual-reports/
test_data/
test-data/
others/

# Template verification: the captures a run leaves behind, the templates
# themselves, and anything derived from them. Confidential on the same footing
# as the report trees above -- a captured request carries live session cookies,
# and a template carries real programs and treaty terms.
#
# Check these with `git check-ignore -v <dir>` and NOT a trailing slash. With
# one, git reports a match against a blank line in this file and exits 0, which
# reads as "ignored" and is not. `git status` is the honest answer.
comparison/
template_comp_data/
template-comp-data/
basic_template_comparison/
basic-template-comparison/

# The capture tree, when it is dropped at the top of the checkout rather than
# under comparison/. Anchored with a leading slash on purpose: an unanchored
# `templates/` matches at any depth and would swallow
# template_comparison/templates/, which is the tool's own descriptors and is
# meant to be committed.
/templates/

# A copy of the comparison trees' configuration with no report data in it:
# every meta.json and case.json, in the folders they sit in, so the layout can
# be handed over or restored without moving a single spreadsheet. Ignored
# because those files still carry case labels, exposure database names and
# wizard settings -- the structure is not the secret, but what it is named is.
structure_export/
structure-export/
