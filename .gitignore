# Installed, not authored
node_modules/

# Build output: `npm run build` regenerates all of it from src/
dist/
*.tsbuildinfo

# Test and example output, all written by a command that can be re-run
tests/.fixtures/
test-results/
playwright-report/
examples/out/
examples/cases/
examples/cli-cases/

# Report data. Confidential: golden outputs, downloaded reports, and the
# results of comparing them. Never commit these, and stage explicit paths
# rather than `git add -A` so a future rule change cannot let them through.
#
# Both spellings are listed on purpose. A folder named with a hyphen once sat
# beside the underscored one for an afternoon, uncovered by this file, with 130
# report files visible to git the whole time.
output_comparison/
output-comparison/

# The same rule, for the trees that hold the reports themselves. These are not
# on every machine, which is exactly why they are listed before one appears:
# a folder becomes visible to git the moment it lands, not the moment somebody
# remembers it.
report-comparison/
report_comparison/
actual_reports/
actual-reports/
test_data/
test-data/
others/

# Captured sessions and the templates they produce. Network captures carry live
# cookies, and the templates carry real programs and treaty terms, so this tree
# is confidential on both counts.
#
# Checked with `git check-ignore -v <dir>` and NOT a trailing slash: with one,
# git will happily report a match against a blank line in this file and exit 0,
# which reads as "ignored" and is not. `git status` is the honest answer.
template_comp_data/
template-comp-data/
