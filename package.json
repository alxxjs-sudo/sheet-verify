{
  "name": "sheet-verify",
  "version": "1.10.2",
  "description": "Schema-drift-tolerant comparison for generated Excel/CSV outputs, with a Playwright matcher.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./matcher": "./dist/matcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "check": "npm run typecheck && npm run links && npm test",
    "precompare": "npm run build",
    "compare": "node dist/cli.js",
    "prerecalc": "npm run build",
    "recalc": "node dist/cli.js --recalc",
    "presummary": "npm run build",
    "summary": "node dist/cli.js --summary",
    "prespec": "npm run build",
    "spec": "node dist/cli.js --print-spec",
    "prewrite:meta": "npm run build",
    "write:meta": "node dist/cli.js --write-meta",
    "prewrite:expect": "npm run build",
    "write:expect": "node dist/cli.js --write-expect",
    "prebless": "npm run build",
    "bless": "node dist/cli.js --bless",
    "prebare": "npm run build",
    "bare": "node dist/cli.js --bare",
    "prefidelity": "npm run build",
    "fidelity": "node dist/fidelity-cli.js",
    "clean": "node scripts/clean-results.mjs",
    "clean:dry": "node scripts/clean-results.mjs --dry",
    "links": "node scripts/check-links.mjs",
    "example": "node --experimental-strip-types examples/run-cases.ts",
    "example:case-json": "node --experimental-strip-types examples/case-json-demo.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "bin": {
    "sheet-verify": "./dist/cli.js",
    "sheet-fidelity": "./dist/fidelity-cli.js"
  }
}
